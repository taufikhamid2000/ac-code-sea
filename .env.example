# Supabase — community level sharing (server-only; do NOT prefix NEXT_PUBLIC).
# These are read by the /api/levels routes via lib/supabase/admin.ts.
# Copy this file to .env.local and fill in the real values from the
# Supabase dashboard: Project Settings → API.

# Project URL (master_db)
SUPABASE_URL=https://hmkjszolqnpcsoatrgcu.supabase.co

# Service-role key (secret — keep server-side only, never commit the real one)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
