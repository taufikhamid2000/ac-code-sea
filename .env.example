# Supabase — auth + community level sharing.
# Copy to .env.local and fill from the Supabase dashboard:
#   Project Settings → API.
#
# The app talks to Supabase directly from the browser using the public
# anon key; Row-Level Security governs access. These two are required:

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
